{
  "name": "car-rental-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint projects/s-ui src/app/domains src/app/core/i18n src/app/core/query src/app/dev --max-warnings 0 --no-warn-ignored --no-error-on-unmatched-pattern",
    "lint:legacy": "eslint src/app",
    "lint:styles": "stylelint \"projects/s-ui/**/*.{css,scss}\" \"src/app/domains/**/*.{css,scss}\" \"src/app/core/shell/**/*.{css,scss}\" \"src/app/core/i18n/**/*.{css,scss}\" \"src/app/dev/**/*.{css,scss}\" --max-warnings 0 --allow-empty-input",
    "lint:styles:legacy": "stylelint \"src/**/*.{css,scss}\"",
    "format": "prettier --no-error-on-unmatched-pattern --write \"projects/s-ui/**/*\" \"src/app/domains/**/*\" \"src/app/core/i18n/**/*\" \"src/app/core/query/**/*\" \"src/app/dev/**/*\" \"docs/**/*.md\" \"scripts/**/*.mjs\" \"*.{mjs,json,md}\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"projects/s-ui/**/*\" \"src/app/domains/**/*\" \"src/app/core/i18n/**/*\" \"src/app/core/query/**/*\" \"src/app/dev/**/*\" \"docs/**/*.md\" \"scripts/**/*.mjs\" \"*.{mjs,json,md}\"",
    "verify": "npm run format:check && npm run lint && npm run lint:styles && npm run i18n:check && ng build && ng test --watch=false",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ],
    "endOfLine": "auto"
  },
  "private": true,
  "packageManager": "npm@11.6.4",
  "dependencies": {
    "@angular/animations": "^21.1.5",
    "@angular/cdk": "~21.1",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@microsoft/signalr": "^10.0.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@primeuix/themes": "^2.0.3",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.1",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "angular-eslint": "~21.4.0",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  }
}
